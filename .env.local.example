IOL_USERNAME=
IOL_PASSWORD=
FRED_API_KEY=
# Login con Google (NextAuth/Auth.js): AUTH_SECRET es cualquier string largo y aleatorio
# (`npx auth secret` lo genera solo). AUTH_GOOGLE_ID/SECRET salen de Google Cloud Console
# -> APIs & Services -> Credentials -> crear un "OAuth client ID" tipo "Web application".
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Base de datos (usuarios logueados + cache propio de cashflow de bonos — ver prisma/schema.prisma).
# Vercel las agrega solas al instalar la integración de Neon (Storage -> Marketplace -> Neon) y se
# bajan local con `vercel env pull .env.local`: DATABASE_URL es la conexión pooled (la que usa la
# app), DATABASE_URL_UNPOOLED la directa (la que necesita `prisma migrate`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Docta Capital (bonos/FCI): client_id y client_secret se generan en
# app.docta.com.ar/dashboard/account/api, después de crear una cuenta en
# app.docta.com.ar/auth. Plan Basic (10 req/min, 15/día) es gratis.
DOCTA_CLIENT_ID=
DOCTA_CLIENT_SECRET=
# Opcional: resumen con IA en el reporte PDF (gratis en aistudio.google.com/apikey). Sin esta clave, el PDF se genera igual sin esa sección.
GEMINI_API_KEY=
# Panel de análisis de cripto (market cap, supply, ATH/ATL, histórico): plan Demo gratis
# (sin tarjeta), se genera en coingecko.com/en/api/pricing -> Demo -> "Get Demo API Key".
COINGECKO_API_KEY=
# Reporte diario: solo en producción. BLOB_READ_WRITE_TOKEN lo agrega Vercel al crear un Blob store en el proyecto;
# CRON_SECRET es cualquier string largo y aleatorio (Vercel lo manda como Bearer al cron).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

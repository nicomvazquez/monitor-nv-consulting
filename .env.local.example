IOL_USERNAME=
IOL_PASSWORD=
FRED_API_KEY=
# Docta Capital (bonos/FCI): client_id y client_secret se generan en
# app.docta.com.ar/dashboard/account/api, después de crear una cuenta en
# app.docta.com.ar/auth. Plan Basic (10 req/min, 15/día) es gratis.
DOCTA_CLIENT_ID=
DOCTA_CLIENT_SECRET=
# Opcional: resumen con IA en el reporte PDF (gratis en aistudio.google.com/apikey). Sin esta clave, el PDF se genera igual sin esa sección.
GEMINI_API_KEY=
# Panel de análisis de cripto (market cap, supply, ATH/ATL, histórico): plan Demo gratis
# (sin tarjeta), se genera en coingecko.com/en/api/pricing -> Demo -> "Get Demo API Key".
COINGECKO_API_KEY=
# Reporte diario: solo en producción. BLOB_READ_WRITE_TOKEN lo agrega Vercel al crear un Blob store en el proyecto;
# CRON_SECRET es cualquier string largo y aleatorio (Vercel lo manda como Bearer al cron).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
